# =========================================================
#  PORTFÓLIO — VARIÁVEIS DE AMBIENTE
#  Copie este arquivo para .env.local e preencha os valores.
# =========================================================

# ---- Login do painel admin (/admin) ----
ADMIN_USERNAME="vinicius_viti"
ADMIN_PASSWORD="#Verniz#290104"
# String longa e aleatória usada para assinar o cookie de sessão do admin.
# Gere uma com:  openssl rand -base64 48
AUTH_SECRET=troque-por-uma-string-aleatoria-bem-longa

# ---- Supabase (OPCIONAL) ----
# O site funciona sem Supabase, usando o conteúdo padrão do currículo.
# Preencha para habilitar edição pelo painel admin e persistência no banco.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role (somente server-side — NUNCA exponha no client).
SUPABASE_SERVICE_ROLE_KEY=
# Nome do bucket de Storage para imagens (crie no Supabase).
NEXT_PUBLIC_SUPABASE_BUCKET=assets
